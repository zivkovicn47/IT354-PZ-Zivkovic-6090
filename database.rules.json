{
  "rules": {
    "Cars": {
      ".read": true,
      ".indexOn": ["userId"],

      "$carId": {
        ".write": "auth != null && (!data.exists() ? newData.child('userId').val() === auth.uid : data.child('userId').val() === auth.uid)",

        ".validate": "newData.hasChildren(['title', 'price', 'categoryId', 'picUrl', 'userId'])",

        "title": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "picUrl": { ".validate": "newData.isString() && newData.val().matches(/^https?:\\/\\/.+/)" },
        "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" },

        "price": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "categoryId": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "productionYear": { ".validate": "newData.isNumber() && newData.val() >= 1950 && newData.val() <= 2100" },
        "mileage": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "engineVolume": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "enginePower": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "highestSpeed": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "seats": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9" },

        "fuelType": { ".validate": "newData.isString()" },
        "transmission": { ".validate": "newData.isString()" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" }
      }
    },

    "Category": {
      ".read": true,
      ".write": false
    }
  }
}
